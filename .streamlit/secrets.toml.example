# Copy this file to ".streamlit/secrets.toml" (for your computer) or paste its
# contents into the app's "Secrets" box on Streamlit Community Cloud.
# NEVER upload the real secrets.toml to GitHub.

[database]
# The connection address from Supabase (Project -> Connect -> Session pooler).
# Leave it empty ("") to use a local test file on your own computer instead.
url = "postgresql://postgres.xxxxxxxx:YOUR-DATABASE-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres"

[access]
# Password for people who only VIEW the app.
# Leave it empty ("") if anyone with the link should be able to view.
viewer_password = "choose-a-viewer-password"

[editors]
# One line per person who can ADD and CHANGE entries:  Name = "their password"
# Put names with spaces in quotes, e.g.  "Store Manager" = "password"
Burhan = "choose-a-strong-password"
